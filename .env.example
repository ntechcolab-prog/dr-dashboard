# Neon Postgres connection string (provision a free project at neon.tech).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Comma-separated emails that become admins on signup.
ADMIN_EMAILS=gabriel.oliveira@netzsch.com
