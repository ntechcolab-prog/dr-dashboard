# Neon Postgres connection string (provision a free project at neon.tech).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Comma-separated emails that become admins on signup.
ADMIN_EMAILS=gabriel.oliveira@netzsch.com

# --- IRIS / Notify backend integration --------------------------------------
# Config is NOT read from env at runtime. It is injected framework-neutrally via
# `public/runtime-config.js` → window.configuration (the same pattern the Notify
# `web` apps use). Edit that file for local/staging values; deploy templates it.
# See public/runtime-config.js.
